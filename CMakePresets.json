{
    "version": 3,
    "configurePresets": [
      {
        "name": "default",
        "hidden": true,
        "binaryDir": "${sourceDir}/build/${presetName}"
      },
      {
        "name": "debug",
        "inherits": "default",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "release",
        "inherits": "default",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release"
        }
      },
      {
        "name": "test",
        "description": "build tests",
        "inherits": "debug",
        "cacheVariables": {
          "ENABLE_TESTING": "ON"
        }
      }
    ],
    "buildPresets": [
      {
        "name": "debug",
        "configurePreset": "debug"
      },
      {
        "name": "release",
        "configurePreset": "release"
      }
    ],
    "testPresets": [
      {
        "name": "run-tests",
        "description": "Run all tests",
        "configurePreset": "test"
      }
    ]
  }